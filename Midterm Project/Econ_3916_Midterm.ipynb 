      "source": [
        "# Table 1: summary statistics\n",
        "cols = [\"poverty_rate\", \"ba_share\", \"median_age\", \"pop\", \"poverty_moe\", \"ba_moe\"]\n",
        "table1 = df[cols].describe().T\n",
        "table1 = table1[[\"count\", \"mean\", \"std\", \"min\", \"50%\", \"max\"]]\n",
        "table1.columns = [\"N\", \"Mean\", \"SD\", \"Min\", \"Median\", \"Max\"]\n",
        "\n",
        "# population-weighted mean: what the average person (not the average county) looks like\n",
        "table1[\"Pop.-weighted mean\"] = [np.average(df[c], weights=df[\"pop\"]) for c in cols]\n",
        "table1.loc[\"pop\", \"Pop.-weighted mean\"] = np.nan\n",
        "\n",
        "table1.index = [\"Poverty rate (%)\",\n",
        "                \"Adults 25+ with a bachelor's degree or higher (%)\",\n",
        "                \"Median age (years)\",\n",
        "                \"Population\",\n",
        "                \"Margin of error of poverty rate (± points)\",\n",
        "                \"Margin of error of bachelor's share (± points)\"]\n",
        "print(\"Table 1. Summary statistics, U.S. counties\")\n",
        "display(table1.round(1))\n",
        "print(\"Source: ACS 2020-2024 5-year estimates. One row = one county (50 states + DC).\")\n",
        "print(\"Margin of error = Census 90% margin. Pop.-weighted mean weights each county by its population.\")\n",
        "\n",
        "# Table 2: counties by rural-urban code (a category, so counts instead of a mean)\n",
        "table2 = df.groupby([\"rucc\", \"rucc_label\"]).agg(counties=(\"FIPS\", \"count\"),\n",
        "                                                mean_poverty=(\"poverty_rate\", \"mean\"),\n",
        "                                                mean_ba_share=(\"ba_share\", \"mean\"))\n",
        "print(\"\\nTable 2. Counties by 2023 Rural-Urban Continuum Code\")\n",
        "display(table2.round(1))\n",
        "\n",
        "# The outlier from the checkpoint, next to the largest county\n",
        "display(df[df[\"county\"].isin([\"Loving County, Texas\", \"Los Angeles County, California\"])]\n",
        "        [[\"county\", \"pop\", \"poverty_rate\", \"ba_share\", \"ba_moe\", \"median_age\", \"rucc\"]])"
