      "source": [
        "# Load the three ACS tables. skiprows=[1] skips the second header row (the long labels).\n",
        "pov = pd.read_csv(\"ACSST5Y2024.S1701-Data.csv\", skiprows=[1])\n",
        "edu = pd.read_csv(\"ACSST5Y2024.S1501-Data.csv\", skiprows=[1])\n",
        "age = pd.read_csv(\"ACSDT5Y2024.B01002-Data.csv\", skiprows=[1])\n",
        "\n",
        "# Keep only the columns I need and give them short names\n",
        "pov = pov[[\"GEO_ID\", \"NAME\", \"S1701_C01_001E\", \"S1701_C03_001E\", \"S1701_C03_001M\"]]\n",
        "pov.columns = [\"GEO_ID\", \"county\", \"pop\", \"poverty_rate\", \"poverty_moe\"]\n",
        "\n",
        "edu = edu[[\"GEO_ID\", \"S1501_C02_015E\", \"S1501_C02_015M\"]]\n",
        "edu.columns = [\"GEO_ID\", \"ba_share\", \"ba_moe\"]\n",
        "\n",
        "age = age[[\"GEO_ID\", \"B01002_001E\"]]\n",
        "age.columns = [\"GEO_ID\", \"median_age\"]\n",
        "\n",
        "# RUCC file. Read FIPS as text so the leading zero is kept (01001, not 1001)\n",
        "rucc = pd.read_excel(\"Ruralurbancontinuumcodes2023.xlsx\", dtype={\"FIPS\": str})\n",
        "rucc = rucc[[\"FIPS\", \"RUCC_2023\", \"Description\"]]\n",
        "rucc.columns = [\"FIPS\", \"rucc\", \"rucc_label\"]\n",
        "\n",
        "# Join the ACS tables, then make the 5-digit FIPS code (last 5 characters of GEO_ID)\n",
        "acs = pov.merge(edu, on=\"GEO_ID\").merge(age, on=\"GEO_ID\")\n",
        "acs[\"FIPS\"] = acs[\"GEO_ID\"].str[-5:]\n",
        "n_acs = len(acs)\n",
        "print(\"ACS counties:\", n_acs)\n",
        "\n",
        "# Drop Puerto Rico (state code 72)\n",
        "acs = acs[acs[\"FIPS\"].str[:2] != \"72\"]\n",
        "n_pr = n_acs - len(acs)\n",
        "print(\"Puerto Rico municipios dropped:\", n_pr)\n",
        "\n",
        "# Join with RUCC\n",
        "df = acs.merge(rucc, on=\"FIPS\")\n",
        "print(\"Counties matched with RUCC:\", len(df))\n",
        "\n",
        "# New variables\n",
        "df[\"rucc\"] = df[\"rucc\"].astype(int)\n",
        "df[\"state\"] = df[\"FIPS\"].str[:2]            # first 2 digits = state, used for state dummies\n",
        "df[\"state_id\"] = df[\"state\"].astype(int)    # number version, used to cluster standard errors\n",
        "df[\"log_poverty\"] = np.log(df[\"poverty_rate\"])\n",
        "df[\"metro\"] = df[\"rucc\"] <= 3               # True for metro counties (RUCC 1-3)\n",
        "\n",
        "df.head()"
      ],
